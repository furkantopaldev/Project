<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AtolyeRecete.App.Views.IngredientsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AtolyeRecete.App.ViewModels"
    x:DataType="vm:IngredientsViewModel"
    Title="Hammaddeler">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="+ Ekle" Command="{Binding AddCommand}" />
    </ContentPage.ToolbarItems>

    <CollectionView
        ItemsSource="{Binding Items}"
        SelectionMode="Single"
        SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
        Margin="16,8">
        <CollectionView.EmptyView>
            <Label Text="Henüz hammadde yok. Sağ üstten ekleyebilirsin." Margin="16" />
        </CollectionView.EmptyView>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:IngredientItem">
                <Grid ColumnDefinitions="*,Auto" Padding="8,10">
                    <VerticalStackLayout>
                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                        <Label Text="{Binding PurchaseText}" FontSize="12" TextColor="Gray" />
                    </VerticalStackLayout>
                    <Label
                        Grid.Column="1"
                        Text="{Binding UnitPriceText}"
                        VerticalOptions="Center" />
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
